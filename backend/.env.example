# Copy to backend/.env and adjust. All values are illustrative defaults.

# Browser origins allowed to call the API (JSON list).
GEOMET360_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Upload and decode limits. Keep these aligned with the frontend limits.
GEOMET360_MAX_UPLOAD_BYTES=8000000
GEOMET360_MAX_IMAGE_PIXELS=40000000
GEOMET360_MAX_IMAGE_DIMENSION=10000
GEOMET360_MIN_IMAGE_DIMENSION=64

# Illustrative image-quality thresholds (NOT calibrated to any site or camera).
GEOMET360_MIN_MEAN_BRIGHTNESS=45
GEOMET360_MAX_MEAN_BRIGHTNESS=215
GEOMET360_MAX_DARK_FRACTION=0.55
GEOMET360_MAX_CLIPPED_FRACTION=0.25
GEOMET360_MIN_SHARPNESS=60

# Fail-closed readiness switch. Leave false: there is no validated ore
# classifier or plant readiness policy in this repository.
GEOMET360_READINESS_POLICY_VALIDATED=false
